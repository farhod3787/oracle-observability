# =======================================================
# Oracle Database Connection Configuration
# =======================================================
ORACLE_USER=monitor_user
ORACLE_PASSWORD=MonitoringPassword#2026
ORACLE_HOST=localhost
ORACLE_PORT=1521

# Connect either via Service Name (preferred) or SID
ORACLE_SERVICE_NAME=ORCLPDB1
# ORACLE_SID=ORCL

# Connection mode: THIN (default, no instant client needed) or THICK
ORACLE_CONNECTION_MODE=THIN

# Connection timeouts in seconds
ORACLE_CONNECT_TIMEOUT=5
ORACLE_QUERY_TIMEOUT=10

# =======================================================
# Exporter Configuration
# =======================================================
EXPORTER_HOST=0.0.0.0
EXPORTER_PORT=9161

# Scrape cache TTL in seconds (avoids querying Oracle repeatedly if multiple scrapers hit it)
CACHE_TTL_SECONDS=10

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
